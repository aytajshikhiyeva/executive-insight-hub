{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "itsm-sla",
      "folder": "ITSM",
      "interval": "1m",
      "rules": [
        {
          "uid": "itsm-sla-breach-risk",
          "title": "SLA Breach Risk (per service)",
          "condition": "C",
          "data": [
            {"refId":"A","datasourceUid":"postgres","model":{"format":"table","rawSql":"SELECT service AS metric, 100.0 * SUM(CASE WHEN sla_breached=false THEN 1 ELSE 0 END)::float / NULLIF(COUNT(*),0) AS value FROM incidents WHERE created_at >= NOW() - INTERVAL '24 hours' GROUP BY 1"}},
            {"refId":"C","datasourceUid":"__expr__","model":{"type":"threshold","conditions":[{"evaluator":{"type":"lt","params":[95]}}]}}
          ],
          "for": "10m",
          "annotations": {"summary":"SLA below 95% on {{ $labels.service }}","description":"SLA compliance for the service dropped below the 95% target over the last 24 hours.","runbook_url":"https://runbooks.example.com/sla-breach"},
          "labels": {"severity":"high","team":"itsm","channel":"slack,email,teams"}
        },
        {
          "uid": "itsm-p1-open",
          "title": "P1 Major Incident Open",
          "condition": "C",
          "data": [
            {"refId":"A","datasourceUid":"postgres","model":{"format":"table","rawSql":"SELECT COUNT(*) AS value FROM incidents WHERE priority='P1' AND status NOT IN ('resolved','closed')"}},
            {"refId":"C","datasourceUid":"__expr__","model":{"type":"threshold","conditions":[{"evaluator":{"type":"gt","params":[0]}}]}}
          ],
          "for": "0m",
          "annotations": {"summary":"P1 major incident is open","description":"One or more P1 incidents are currently unresolved. Trigger major-incident bridge."},
          "labels": {"severity":"critical","channel":"pagerduty,slack,teams,email"}
        }
      ]
    },
    {
      "orgId": 1,
      "name": "itsm-changes",
      "folder": "ITSM",
      "interval": "5m",
      "rules": [
        {
          "uid": "itsm-emergency-change-rate",
          "title": "Emergency Change Rate > 10%",
          "condition": "C",
          "data": [
            {"refId":"A","datasourceUid":"postgres","model":{"format":"table","rawSql":"SELECT 100.0 * SUM(CASE WHEN change_type='emergency' THEN 1 ELSE 0 END)::float / NULLIF(COUNT(*),0) AS value FROM changes WHERE created_at >= NOW() - INTERVAL '30 days'"}},
            {"refId":"C","datasourceUid":"__expr__","model":{"type":"threshold","conditions":[{"evaluator":{"type":"gt","params":[10]}}]}}
          ],
          "for": "15m",
          "annotations": {"summary":"Emergency change rate exceeded 10%","description":"CAB process bypass rate elevated. Review change quality and unplanned work."},
          "labels": {"severity":"warning","channel":"email,teams"}
        },
        {
          "uid": "itsm-change-failure-rate",
          "title": "Change Failure Rate > 5%",
          "condition": "C",
          "data": [
            {"refId":"A","datasourceUid":"postgres","model":{"format":"table","rawSql":"SELECT 100.0 * SUM(CASE WHEN status='failed' THEN 1 ELSE 0 END)::float / NULLIF(COUNT(*),0) AS value FROM changes WHERE actual_end >= NOW() - INTERVAL '30 days'"}},
            {"refId":"C","datasourceUid":"__expr__","model":{"type":"threshold","conditions":[{"evaluator":{"type":"gt","params":[5]}}]}}
          ],
          "for": "15m",
          "annotations": {"summary":"Change failure rate above 5%","description":"Review failed changes and consider a change freeze on the impacted service tier."},
          "labels": {"severity":"warning","channel":"email"}
        }
      ]
    },
    {
      "orgId": 1,
      "name": "itsm-cmdb",
      "folder": "ITSM",
      "interval": "10m",
      "rules": [
        {
          "uid": "itsm-cmdb-coverage-low",
          "title": "CMDB Coverage < 90%",
          "condition": "C",
          "data": [
            {"refId":"A","datasourceUid":"postgres","model":{"format":"table","rawSql":"SELECT 100.0 * SUM(CASE WHEN team IS NOT NULL AND lifecycle_stage IS NOT NULL THEN 1 ELSE 0 END)::float / NULLIF(COUNT(*),0) AS value FROM assets"}},
            {"refId":"C","datasourceUid":"__expr__","model":{"type":"threshold","conditions":[{"evaluator":{"type":"lt","params":[90]}}]}}
          ],
          "for": "1h",
          "annotations": {"summary":"CMDB coverage below 90%","description":"Assets are missing owner or lifecycle. Data quality risk."},
          "labels": {"severity":"warning","channel":"email"}
        },
        {
          "uid": "itsm-eol-assets",
          "title": "EOL Assets (60d) > 500",
          "condition": "C",
          "data": [
            {"refId":"A","datasourceUid":"postgres","model":{"format":"table","rawSql":"SELECT COUNT(*) AS value FROM assets WHERE eol_date BETWEEN NOW() AND NOW() + INTERVAL '60 days'"}},
            {"refId":"C","datasourceUid":"__expr__","model":{"type":"threshold","conditions":[{"evaluator":{"type":"gt","params":[500]}}]}}
          ],
          "for": "1h",
          "annotations": {"summary":"More than 500 assets reach EOL in 60d","description":"Plan refresh or extended-support contracts."},
          "labels": {"severity":"high","channel":"email,teams"}
        }
      ]
    },
    {
      "orgId": 1,
      "name": "itsm-performance",
      "folder": "ITSM",
      "interval": "5m",
      "rules": [
        {
          "uid": "itsm-mttr-breach",
          "title": "MTTR > 4h (non-working hours)",
          "condition": "C",
          "data": [
            {"refId":"A","datasourceUid":"postgres","model":{"format":"table","rawSql":"SELECT AVG(EXTRACT(EPOCH FROM (resolved_at-created_at))/3600.0) AS value FROM incidents WHERE hours_bucket='non_working' AND resolved_at >= NOW() - INTERVAL '24 hours'"}},
            {"refId":"C","datasourceUid":"__expr__","model":{"type":"threshold","conditions":[{"evaluator":{"type":"gt","params":[4]}}]}}
          ],
          "for": "30m",
          "annotations": {"summary":"MTTR NH above 4h","description":"Non-working-hours resolution SLO breached. Review on-call staffing."},
          "labels": {"severity":"high","channel":"slack,teams"}
        },
        {
          "uid": "itsm-recurring-incidents",
          "title": "Recurring Incidents > 10 (30d, per service)",
          "condition": "C",
          "data": [
            {"refId":"A","datasourceUid":"postgres","model":{"format":"table","rawSql":"SELECT service AS metric, COUNT(*) AS value FROM incidents WHERE is_recurring=true AND created_at >= NOW() - INTERVAL '30 days' GROUP BY 1"}},
            {"refId":"C","datasourceUid":"__expr__","model":{"type":"threshold","conditions":[{"evaluator":{"type":"gt","params":[10]}}]}}
          ],
          "for": "1h",
          "annotations": {"summary":"Recurring incidents cluster on {{ $labels.metric }}","description":"Open a Problem record and root-cause analysis."},
          "labels": {"severity":"warning","channel":"email,teams"}
        }
      ]
    }
  ]
}
